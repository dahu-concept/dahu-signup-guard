msgstr "Un journal qui se lit"

#: includes/class-dahu-signup-guard-settings.php:254
msgid "Add an invisible trap field to the registration form"
msgstr "Ajouter un champ piège invisible au formulaire d’inscription"

#: dahu-signup-guard.php:200
msgid "Add what you recognise"
msgstr "Ajoutez ce que vous reconnaissez"

#: includes/class-dahu-signup-guard-settings.php:339
msgid "Address"
msgstr "Adresse"

#: includes/class-dahu-signup-guard-settings.php:298
